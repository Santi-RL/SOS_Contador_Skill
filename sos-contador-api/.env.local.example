# Copiar como ~/.sos-contador/.env.local.
# Las variables del proceso prevalecen sobre este archivo.

SOS_CONTADOR_USUARIO=usuario@correo.com
SOS_CONTADOR_PASSWORD=super-secreto

# Optional overrides.
# SOS_CONTADOR_HOME=C:\ruta\privada\sos-contador
# SOS_CONTADOR_BASE_URL=https://api.sos-contador.com/api-comunidad
# SOS_CONTADOR_SOFT_BASE_URL=https://soft.sos-contador.com
# SOS_CONTADOR_CA_BUNDLE=C:\ruta\al\bundle-ca.pem
# SOS_CONTADOR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
