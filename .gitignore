# Documents and exports are private by default. Public fixtures and skill
# assets must be added only under the explicitly allowed directories.
*.pdf
*.jpg
*.jpeg
*.png
*.xls
*.xlsx
*.csv
!tests/fixtures/**
!sos-contador-api/assets/**

# Common secret-bearing formats
*.pem
*.p12
*.pfx
*.key
*.crt
